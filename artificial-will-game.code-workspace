{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "cmake.options.statusBarVisibility": "hidden",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.cppStandard": "c++23",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.runAutomatically": true,
    "markdownlint.ignore": [".clangd"],
    "files.exclude": {
      "build": true,
      "cmake-build-*": true,
      "vcpkg_installed": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "configure",
        "type": "shell",
        "command": "pwsh -File ${workspaceFolder}/scripts/configure.ps1",
        "group": "build",
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "build",
        "type": "shell",
        "command": "pwsh -File ${workspaceFolder}/scripts/build.ps1",
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "run",
        "type": "shell",
        "command": "pwsh -File ${workspaceFolder}/scripts/run.ps1",
        "group": { "kind": "test", "isDefault": true },
        "presentation": { "reveal": "always", "panel": "dedicated" }
      },
      {
        "label": "clean",
        "type": "shell",
        "command": "pwsh -File ${workspaceFolder}/scripts/clean.ps1",
        "group": "build",
        "presentation": { "reveal": "always", "panel": "shared" }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.cpptools",
      "ms-vscode.cmake-tools",
      "twxs.cmake",
      "ms-vscode.cpptools-themes",
      "streetsidesoftware.code-spell-checker",
      "llvm-vs-code-extensions.vscode-clangd"
    ]
  }
}
